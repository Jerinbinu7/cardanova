# ─────────────────────────────────────────────────────────────────
# Cardanova Spices — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────

# Supabase — same values for BOTH main site and admin portal
# (both connect to the same Supabase project)
VITE_SUPABASE_URL=https://gmoyahcaphzyrkzlcaub.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_lQFKk3PzBmhO58TZ2Ah6TA__F2SqlHq

# ── Build target ─────────────────────────────────────────────────
# Set to 'admin' when building for admin.cardanovaspices.com
# Leave as 'main' (or unset) for the public website build
VITE_BUILD_TARGET=main

# ── Live site URL (used by admin portal for 'View Live Site' link) ─
# Set this in your ADMIN deployment env vars:
VITE_MAIN_SITE_URL=https://cardanovaspices.com

# ── Email Notifications (Resend API) ─────────────────────────────
# Store Admin notification recipient (defaults to zentra.techofficial@gmail.com)
VITE_ADMIN_NOTIFICATION_EMAIL=zentra.techofficial@gmail.com

# Resend API key (Free 3,000 emails/mo from https://resend.com)
# Add your key to send instant order confirmation emails to BOTH Admin and Customer:
RESEND_API_KEY=
VITE_RESEND_API_KEY=
